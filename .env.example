# ============================================================
# GNG 活动日历环境变量示例
# 复制为 .env 后按需填写
# ============================================================

# ------------------------------------------------------------
# 服务基础配置
# ------------------------------------------------------------

# 服务端口
PORT=3000

# Google Sheets 轮询间隔（毫秒）
# 注意：代码内部会强制最小值为 30000
POLL_INTERVAL=30000


# ------------------------------------------------------------
# Google OAuth / Sheets（必填）
# ------------------------------------------------------------

# Google Cloud OAuth Client ID
GOOGLE_CLIENT_ID=your_client_id_here

# Google Cloud OAuth Client Secret
GOOGLE_CLIENT_SECRET=your_client_secret_here

# 运行 `node auth.js` 后拿到的 refresh token
GOOGLE_REFRESH_TOKEN=

# 主活动表 ID
GOOGLE_SHEET_ID=your_google_sheet_id_here

# 第二份表 ID（可选，用于 1.0 event calendar / 活动配置）
# GOOGLE_SHEET_ID_2=


# ------------------------------------------------------------
# Google API 代理（可选）
# ------------------------------------------------------------

# 例如：https://your-worker.example.workers.dev
# GOOGLE_API_PROXY=

# 与 Cloudflare Worker 中的 PROXY_KEY 保持一致
# GOOGLE_API_PROXY_KEY=


# ------------------------------------------------------------
# Event.xlsx（可选但推荐）
# ------------------------------------------------------------

# 默认值：项目目录下的 data/Event.xlsx
# EVENT_EXCEL_PATH=D:\C project\data\Event.xlsx


# ------------------------------------------------------------
# 网页公开地址 / 推送链接
# ------------------------------------------------------------

# SeaTalk 文本/图片推送里的“查看完整日历”地址
# 例如：http://101.133.141.32
# CALENDAR_PUBLIC_URL=


# ------------------------------------------------------------
# SeaTalk（可选）
# ------------------------------------------------------------

# SeaTalk 应用 ID
# SEATALK_APP_ID=

# SeaTalk 应用密钥
# SEATALK_APP_SECRET=

# SeaTalk 回调签名密钥
# 同时也会作为 /api/seatalk-push 与 /api/seatalk-image-push 的 x-internal-key 校验值
# SEATALK_SIGNING_SECRET=

# 默认群组 ID
# SEATALK_GROUP_ID=

# 工作日推送排除日期（北京时间，YYYY-MM-DD，逗号分隔）
# PUSH_HOLIDAYS=2026-01-01,2026-01-02

# 补班工作日（北京时间，YYYY-MM-DD，逗号分隔）
# PUSH_MAKEUP_WORKDAYS=2026-01-04


# ------------------------------------------------------------
# 日历图片渲染（可选）
# ------------------------------------------------------------

# 默认生成路径通常用于服务器环境
# CALENDAR_IMAGE_OUTPUT_PATH=/opt/gng-activity-calendar/public/generated/calendar-push-latest.png

# 渲染脚本请求活动数据的地址
# CALENDAR_IMAGE_API_URL=http://127.0.0.1:3000/api/calendar

# 如果系统无法自动找到 Chromium / Chrome，可手动指定
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser


# ------------------------------------------------------------
# Alpha Knowledge（可选）
# ------------------------------------------------------------

# ALPHA_KNOWLEDGE_API_KEY=

# 默认值为 7420，可按实际专家 ID 修改
# ALPHA_KNOWLEDGE_EXPERT_ID=7420

# 可选，知识库引用来源链接
# ALPHA_KNOWLEDGE_CITATION_URL=


# ------------------------------------------------------------
# 自动部署（可选）
# ------------------------------------------------------------

# GitHub webhook 的签名密钥，对应 /api/deploy
# DEPLOY_SECRET=


# ------------------------------------------------------------
# 网络代理（可选）
# ------------------------------------------------------------

# SeaTalk / 其他出网请求会尝试读取这些变量
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
